# 构建产物
target/
dist/
build/
*.class
*.jar
!**/lib/*.jar
# OpenAPI 生成的 Mock 数据（npm run mock:gen 可再生）
platform/web/mock/

# 依赖
node_modules/
.pnpm-store/
# 前端包管理器是 pnpm（pnpm-lock.yaml 才是唯一事实来源，CI 用 --frozen-lockfile）。
# 顺手跑 npm install 会生成一份 package-lock.json，与 pnpm 锁文件冲突，一律不入库；
# tools/api-docs-mcp 是独立 npm 项目，它的锁文件仍然要提交，所以只忽略这一处。
platform/web/package-lock.json

# 日志
*.log
logs/

# IDE / 编辑器
.idea/
*.iml
.vscode/
*.swp

# 本地环境与临时文件
.tmp-*
.env
.env.local
.env.*.local
*.local.yml
.dsh-office-*/
.DS_Store
Thumbs.db

# 外部源码快照（仅分析用，不入库）
# 需要时按各仓库 README 重新克隆，例如：
#   git clone --depth 1 https://gitee.com/dromara/RuoYi-Vue-Plus.git
#   git clone --depth 1 https://gitee.com/y_project/RuoYi.git
#   git clone --depth 1 https://github.com/agentscope-ai/agentscope-java.git
vendor/
RuoYi/
RuoYi-Vue-Plus/
agentscope-java/
ruoyi-ai/

# Python
__pycache__/
*.pyc

# 本地工作区与运行数据
data/

# 编辑器/工具产物
.workbuddy/
tsconfig.tsbuildinfo
*.tsbuildinfo

# Agent 运行数据与调试产物
.agent/
.screenshots/
.playwright-cli/
docs/research/*.png
# AgentScope 运行时工作区（会话 jsonl / memory）：属于本机运行状态，
# 含对话内容与记忆摘要，不是源码。漏掉这一行会让一次 `git add -A` 把会话日志提交进仓库。
.agentscope/

# 会话归档运行时状态（active 会话与测试证据，归档在 docs/process、docs/summary）
docs/.session/

# 本地登录配置（可能含凭据）与临时校验脚本
login.yaml
platform/web/scripts/_tmp-*.mjs

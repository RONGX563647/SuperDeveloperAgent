{
  "name": "agent-platform-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:mock": "npm run mock:gen && VITE_MOCK=1 vite",
    "build": "vue-tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "vue-tsc --noEmit",
    "gen:api-types": "openapi-typescript ../agent-gateway/src/main/resources/api/openapi.json -o src/api/generated/schema.d.ts",
    "check:api-types": "npm run gen:api-types && git diff --exit-code -- src/api/generated/schema.d.ts",
    "mock:gen": "node ../../tools/api-docs-mcp/mock.mjs"
  },
  "dependencies": {
    "@element-plus/icons-vue": "^2.3.2",
    "@unovis/ts": "^1.8.1",
    "@unovis/vue": "^1.8.1",
    "element-plus": "^2.8.8",
    "vue": "^3.5.13",
    "vue-router": "^4.4.5"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@vitejs/plugin-vue": "^5.2.1",
    "openapi-typescript": "^7.13.0",
    "puppeteer-core": "^25.16.0",
    "typescript": "^5.6.3",
    "vite": "^5.4.11",
    "vue-tsc": "^2.1.10"
  }
}

<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>org.example.agent</groupId>
        <artifactId>agent-platform</artifactId>
        <version>0.1.0-SNAPSHOT</version>
    </parent>
    <artifactId>spec-checks</artifactId>
    <name>spec-checks</name>
    <description>项目规约自动化检查（架构 + 禁令 + 凭证 + 迁移锁）</description>

    <dependencies>
        <!-- 需要读到全部模块的字节码（ArchUnit） -->
        <dependency>
            <groupId>org.example.agent</groupId>
            <artifactId>agent-domain</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.example.agent</groupId>
            <artifactId>agent-infra</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.example.agent</groupId>
            <artifactId>agent-governance</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.example.agent</groupId>
            <artifactId>agent-executor</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.example.agent</groupId>
            <artifactId>agent-tools</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.example.agent</groupId>
            <artifactId>agent-runtime</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.example.agent</groupId>
            <artifactId>agent-gateway</artifactId>
            <scope>test</scope>
        </dependency>

        <dependency>
            <groupId>com.tngtech.archunit</groupId>
            <artifactId>archunit-junit5</artifactId>
            <version>${archunit.version}</version>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <configuration>
                    <systemPropertyVariables>
                        <!-- 扫描根 = platform/（即本模块的上一级） -->
                        <spec.root>${project.basedir}/..</spec.root>
                    </systemPropertyVariables>
                    <trimStackTrace>false</trimStackTrace>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>

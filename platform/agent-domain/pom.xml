<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>top.rongx</groupId>
        <artifactId>agent-platform</artifactId>
        <version>0.1.0-SNAPSHOT</version>
    </parent>
    <artifactId>agent-domain</artifactId>

    <properties>
        <!-- 覆盖率棘轮：当前实测基线小幅下浮，只升不降（见根 pom 说明） -->
        <jacoco.line.minimum>0.33</jacoco.line.minimum>
    </properties>

    <name>agent-domain</name>
    <!-- 规约 §2.3：domain 层零框架依赖（不得引入 Spring / MyBatis / AgentScope）。
         Jackson 是通用序列化库，不属于被禁框架；放在这里作为全平台唯一的只读 mapper 配置点。 -->
    <dependencies>
        <dependency>
            <groupId>com.fasterxml.jackson.core</groupId>
            <artifactId>jackson-databind</artifactId>
        </dependency>
        <dependency>
            <groupId>com.fasterxml.jackson.datatype</groupId>
            <artifactId>jackson-datatype-jsr310</artifactId>
        </dependency>
        <!-- 规约 §2.3 允许的通用库（同 Jackson 先例）：日志门面，版本由 spring-boot-dependencies 管理 -->
        <dependency>
            <groupId>org.slf4j</groupId>
            <artifactId>slf4j-api</artifactId>
        </dependency>
    </dependencies>
</project>

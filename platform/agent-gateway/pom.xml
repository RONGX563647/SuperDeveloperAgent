<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>top.rongx</groupId>
        <artifactId>agent-platform</artifactId>
        <version>0.1.0-SNAPSHOT</version>
    </parent>
    <artifactId>agent-gateway</artifactId>

    <properties>
        <!-- 覆盖率棘轮：当前实测基线小幅下浮，只升不降（见根 pom 说明） -->
        <jacoco.line.minimum>0.28</jacoco.line.minimum>
    </properties>

    <name>agent-gateway</name>

    <dependencies>
        <dependency>
            <groupId>top.rongx</groupId>
            <artifactId>agent-runtime</artifactId>
        </dependency>
        <dependency>
            <groupId>top.rongx</groupId>
            <artifactId>agent-infra</artifactId>
        </dependency>
        <!-- 执行面实现（ActionRunner 等）由网关装配 -->
        <dependency>
            <groupId>top.rongx</groupId>
            <artifactId>agent-executor</artifactId>
        </dependency>
        <!-- 工具实现与治理服务由网关（组装根）显式引入，不再经 runtime 传递依赖 -->
        <dependency>
            <groupId>top.rongx</groupId>
            <artifactId>agent-tools</artifactId>
        </dependency>
        <dependency>
            <groupId>top.rongx</groupId>
            <artifactId>agent-governance</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-webmvc</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>
        <!-- Flyway：统一迁移管理（建表脚本在 agent-infra 的 db/migration 下）。
             Flyway 10+ 按库拆模块：PG 在 flyway-database-postgresql，SQLite 仍在 flyway-core。 -->
        <dependency>
            <groupId>org.flywaydb</groupId>
            <artifactId>flyway-core</artifactId>
        </dependency>
        <dependency>
            <groupId>org.flywaydb</groupId>
            <artifactId>flyway-database-postgresql</artifactId>
        </dependency>
        <!-- Boot 4 把 Flyway 自动配置拆成了独立模块，必须显式引入才会执行迁移 -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-flyway</artifactId>
        </dependency>
        <!-- OpenAPI 3：/v3/api-docs + Swagger UI（/doc.html）。
             单源 = 运行时生成的规范；Knife4j 4.5 依赖 springdoc 2.x，与 Boot 4 不兼容，
             因此 /doc.html 由 springdoc 自带的 Swagger UI 提供（路径保持 Knife4j 习惯）。 -->
        <dependency>
            <groupId>org.springdoc</groupId>
            <artifactId>springdoc-openapi-starter-webmvc-ui</artifactId>
            <version>${springdoc.version}</version>
        </dependency>
        <!-- Jackson 2：AgentScope 事件按 Jackson 2 注解，Boot 4 默认只提供 Jackson 3 -->
        <dependency>
            <groupId>com.fasterxml.jackson.core</groupId>
            <artifactId>jackson-databind</artifactId>
        </dependency>
        <!-- Sa-Token：登录态与权限（Boot 4 专用 starter） -->
        <dependency>
            <groupId>cn.dev33</groupId>
            <artifactId>sa-token-spring-boot4-starter</artifactId>
            <version>1.46.0</version>
        </dependency>
        <!-- BCrypt：密码哈希（只取 crypto，不引入整个 Spring Security 过滤器链） -->
        <dependency>
            <groupId>org.springframework.security</groupId>
            <artifactId>spring-security-crypto</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>com.fasterxml.jackson.datatype</groupId>
            <artifactId>jackson-datatype-jsr310</artifactId>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <configuration>
                    <mainClass>top.rongx.agent.gateway.AgentApplication</mainClass>
                    <!-- sqlite-jdbc 通过 System.load 加载本地库：JDK 24+ 需要显式放行，
                         否则每次启动都会打印 Restricted method 警告（JDK 21 上该参数无害） -->
                    <jvmArguments>--enable-native-access=ALL-UNNAMED</jvmArguments>
                </configuration>
                <executions>
                    <execution>
                        <goals>
                            <goal>repackage</goal>
                        </goals>
                        <configuration>
                            <!-- 生成 -exec.jar 作为可执行包，主 artifact 保持普通 jar，
                                 否则 ArchUnit 读不到本模块的类（BOOT-INF/classes 不可见） -->
                            <classifier>exec</classifier>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>

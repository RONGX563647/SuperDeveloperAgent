<?xml version="1.0" encoding="UTF-8"?>
<!--
  token 用量独立日志：logger 名 token.usage（代码里固定）单独滚动到 logs/token-usage.log，
  与其他运行日志分开，便于按天核对每个会话/模型的消耗。
-->
<configuration>
    <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>%d{HH:mm:ss.SSS} %-5level [%thread] %logger{36} - %msg%n</pattern>
            <charset>UTF-8</charset>
        </encoder>
    </appender>

    <appender name="TOKEN_USAGE" class="ch.qos.logback.core.rolling.RollingFileAppender">
        <file>logs/token-usage.log</file>
        <rollingPolicy class="ch.qos.logback.core.rolling.TimeBasedRollingPolicy">
            <fileNamePattern>logs/token-usage.%d{yyyy-MM-dd}.log</fileNamePattern>
            <maxHistory>90</maxHistory>
        </rollingPolicy>
        <encoder>
            <pattern>%d{yyyy-MM-dd HH:mm:ss.SSS} %msg%n</pattern>
            <charset>UTF-8</charset>
        </encoder>
    </appender>

    <logger name="token.usage" level="INFO" additivity="false">
        <appender-ref ref="TOKEN_USAGE"/>
    </logger>

    <!-- 分项归因：本轮加载了哪些插件、各占多少 schema 字符（token 代理），单独滚动便于追踪。 -->
    <appender name="TOKEN_ATTRIBUTION" class="ch.qos.logback.core.rolling.RollingFileAppender">
        <file>logs/token-attribution.log</file>
        <rollingPolicy class="ch.qos.logback.core.rolling.TimeBasedRollingPolicy">
            <fileNamePattern>logs/token-attribution.%d{yyyy-MM-dd}.log</fileNamePattern>
            <maxHistory>90</maxHistory>
        </rollingPolicy>
        <encoder>
            <pattern>%d{yyyy-MM-dd HH:mm:ss.SSS} %msg%n</pattern>
            <charset>UTF-8</charset>
        </encoder>
    </appender>
    <logger name="token.attribution" level="INFO" additivity="false">
        <appender-ref ref="TOKEN_ATTRIBUTION"/>
    </logger>

    <root level="INFO">
        <appender-ref ref="CONSOLE"/>
    </root>
</configuration>

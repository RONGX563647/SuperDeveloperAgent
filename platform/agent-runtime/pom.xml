<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>top.rongx</groupId>
        <artifactId>agent-platform</artifactId>
        <version>0.1.0-SNAPSHOT</version>
    </parent>
    <artifactId>agent-runtime</artifactId>

    <properties>
        <!-- 覆盖率棘轮：当前实测基线小幅下浮，只升不降（见根 pom 说明） -->
        <jacoco.line.minimum>0.51</jacoco.line.minimum>
    </properties>

    <name>agent-runtime</name>

    <dependencies>
        <dependency>
            <groupId>top.rongx</groupId>
            <artifactId>agent-domain</artifactId>
        </dependency>
        <!-- 运行层只依赖领域端口；状态存储、主密钥、技能目录的实现都在 infra -->

        <dependency>
            <groupId>io.agentscope</groupId>
            <artifactId>agentscope-core</artifactId>
        </dependency>
        <!-- 官方 HarnessAgent：ReActAgent 的增强封装，负责 Agent 循环与可复用中间件；
             执行隔离/门禁仍由平台自建组件负责（A3 规约：执行面不依赖 LLM SDK） -->
        <dependency>
            <groupId>io.agentscope</groupId>
            <artifactId>agentscope-harness</artifactId>
        </dependency>
        <!-- 模型扩展：OpenAI 兼容端点（通义 / DeepSeek / 自建 vLLM 均可复用） -->
        <dependency>
            <groupId>io.agentscope</groupId>
            <artifactId>agentscope-extensions-model-openai</artifactId>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter</artifactId>
        </dependency>

        <dependency>
            <groupId>com.fasterxml.jackson.core</groupId>
            <artifactId>jackson-databind</artifactId>
        </dependency>
    </dependencies>
</project>

#!/bin/sh
# 会话归档门禁（pre-commit）：代码提交必须有进行中的会话，且测试通过。
# 安装：powershell -ExecutionPolicy Bypass -File tools/session-archive/install-hooks.ps1
set -e

root=$(git rev-parse --show-toplevel)
cd "$root"

if command -v python >/dev/null 2>&1; then
    PY=python
elif command -v python3 >/dev/null 2>&1; then
    PY=python3
elif command -v py >/dev/null 2>&1; then
    PY="py -3"
else
    echo "ERROR: 未找到 python，无法执行会话归档门禁（见 docs/session-archive-spec-v1.md）" >&2
    exit 1
fi

exec $PY tools/session-archive/gate.py gate-pre-commit
